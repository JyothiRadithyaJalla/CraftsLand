# Application Environment ('development' | 'production')
VITE_APP_ENV=development

# Supabase Credentials (Public Client Keys Only)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Media Storage Base URL (Cloudflare R2 / Local Fallback)
VITE_MEDIA_BASE_URL=

# Razorpay Test Mode (Public Client Key Only — Never expose Secret Key to browser)
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder

# Note: The following secrets must ONLY be set in Supabase Edge Functions environment:
# - RAZORPAY_KEY_ID
# - RAZORPAY_KEY_SECRET
# - RAZORPAY_WEBHOOK_SECRET
